rules_version = '2';
// HoK Skinventory — Firestore Security Rules.
// Data model (see firebase-sync.js):
//   users/{uid}                  -> theme metadata (+ legacy wishlist array)
//   users/{uid}/wishlist/{item}  -> one skin per document
// Paste these rules into the Firebase console (Firestore Database > Rules).
// They are NOT auto-deployed (no firebase.json / CI deploy in this repo).
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may read/write ONLY their own document subtree.
    // Nobody (including other signed-in users) can read or write another
    // user's wishlist or theme settings.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /wishlist/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
